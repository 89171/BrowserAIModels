# Public origin, no trailing slash. Every canonical, hreflang, sitemap and robots
# URL is derived from it, so production builds fail when it is unset.
NEXT_PUBLIC_SITE_URL=https://browseraimodels.xyz

# Object-storage origin for assets above the host's 25 MiB per-file cap (the
# ONNX Runtime wasm builds in public/ort). Setting it makes the build drop the
# local copies from out/ — see scripts/prune-large-assets.cjs.
NEXT_PUBLIC_ASSET_BASE=https://aimodels.s3.cn-north-1.jdcloud-oss.com
