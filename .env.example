# Public origin, no trailing slash. Every canonical, hreflang, sitemap and robots
# URL is derived from it, so production builds fail when it is unset.
NEXT_PUBLIC_SITE_URL=https://browseraimodels.xyz

# Object-storage origin (no trailing slash) for binaries too large for the static
# host — currently the ONNX Runtime wasm builds in public/ort. Unset in dev, where
# the vendored copies are served from /public. When set, a production build
# removes the local copies from out/, so upload them first:
#   for f in public/ort/*; do fuc "$f"; done
NEXT_PUBLIC_ASSET_BASE=https://aimodels.s3.cn-north-1.jdcloud-oss.com
