{
  "name": "web-ai-models",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "npm run prune:assets && npm run check:seo",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-translations.cjs",
    "check:seo": "node scripts/check-seo.cjs",
    "prune:assets": "node scripts/prune-large-assets.cjs",
    "prebuild": "npm run check:i18n && node scripts/copy-paddleocr.cjs && node scripts/copy-easyocr.cjs",
    "copy:vendor": "node scripts/copy-ort-wasm.cjs && node scripts/copy-paddleocr.cjs && node scripts/copy-easyocr.cjs",
    "postinstall": "npm run copy:vendor",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "predev": "node scripts/copy-paddleocr.cjs && node scripts/copy-easyocr.cjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@jitsi/rnnoise-wasm": "^0.2.1",
    "@mediapipe/tasks-vision": "^1.1.1",
    "@paddleocr/paddleocr-js": "0.4.2",
    "@qduc/easyocr-core": "0.1.3",
    "@qduc/easyocr-web": "0.1.3",
    "mp4-muxer": "^5.2.2",
    "next": "16.4.1",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.1",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
