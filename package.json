{
  "name": "web-ai-models",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.cjs,.mjs,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-translations.cjs",
    "prebuild": "npm run check:i18n",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs"
  },
  "dependencies": {
    "next": "15.5.27",
    "next-intl": "4.14.9",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
